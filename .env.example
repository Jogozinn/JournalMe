DATABASE_URL=sqlite:///./journalme.db
JOURNALME_STORAGE_PATH=./storage
JOURNALME_DATA_PROVIDER=local
JOURNALME_STORAGE_PROVIDER=local
JOURNALME_CORS_ORIGINS=http://localhost:3070,http://127.0.0.1:3066
NEXT_PUBLIC_JOURNALME_API_URL=http://127.0.0.1:8067/api/v1
# Browser-safe hosted web settings (never put a service-role key here).
# NEXT_PUBLIC_AUTH_MODE=hosted
# NEXT_PUBLIC_JOURNALME_API_URL=https://api.example.com/api/v1
# NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use the anon key variable instead.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Future hosted values are intentionally optional while providers remain local.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=
# SUPABASE_DB_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# SUPABASE_JWT_AUDIENCE=authenticated
# JOURNALME_MIGRATION_LOCAL_USER_ID=
