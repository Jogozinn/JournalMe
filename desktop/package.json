{
  "name": "journalme-desktop",
  "version": "0.1.0",
  "private": true,
  "author": "JournalMe",
  "description": "JournalMe Electron desktop shell",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-renderer.mjs",
    "dev": "npm run build && cross-env JOURNALME_DESKTOP_DEV=1 electron .",
    "start": "npm run build && electron .",
    "test": "tsc -p tsconfig.test.json && node .test-dist/tests/config.test.js && node .test-dist/tests/backend.test.js && node .test-dist/tests/capture.test.js && node .test-dist/tests/frontend.test.js && node .test-dist/tests/runtime.test.js",
    "typecheck": "tsc --noEmit",
    "package:win": "npm run build && electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.journalme.desktop",
    "productName": "JournalMe",
    "directories": { "output": "release" },
    "files": ["dist/**", "assets/**", "package.json"],
    "extraResources": [
      { "from": "../frontend/.next/standalone", "to": "frontend" },
      { "from": "../frontend/.next/static", "to": "frontend/.next/static" },
      { "from": "../frontend/public", "to": "frontend/public", "filter": ["**/*"] }
    ],
    "win": { "target": ["nsis", "portable"], "icon": "assets/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "cross-env": "^7.0.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3"
  }
}
