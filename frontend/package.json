{
  "name": "journalme-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --hostname localhost --port 3070",
    "build": "next build",
    "start": "next start --hostname localhost --port 3070",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "playwright": "playwright test",
    "desktop:dev": "npm --prefix ../desktop run dev",
    "desktop:build": "npm --prefix ../desktop run package:win",
    "desktop:start": "npm --prefix ../desktop run start",
    "dev:webpack": "next dev --hostname localhost --port 3070",
    "dev:clean": "node -e \"require('fs').rmSync('.next-dev',{recursive:true,force:true})\" && next dev --turbopack --hostname localhost --port 3070"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "^15.5.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "postcss": "8.5.25"
  }
}
